# Copy to .env.local and fill in. .env.local is gitignored.

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini (embeddings) — aistudio.google.com/apikey ----
GEMINI_API_KEY=
# Optional. Defaults to gemini-embedding-001 (pinned to 768 dims).
GEMINI_EMBEDDING_MODEL=

# ---- Groq (chat) — console.groq.com ----
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# ---- Stripe (TEST mode keys only) ----
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
